# EXAMPLE ONLY — never commit real credentials.
SECRET_KEY=replace-with-long-random-hex
ADMIN_USER=replace-with-private-admin-name
ADMIN_PASS=replace-with-strong-unique-password
DATABASE_URL=sqlite:///gtech_leads.db
FLASK_DEBUG=0

# Optional: enable ONLY after validating the correct destination and test lead.
CRM_LEAD_SYNC_ENABLED=false
CRM_LEAD_CAPTURE_URL=https://web-production-846ce.up.railway.app/api/public/lead

# G TECH OFICIAL — MERCADO PAGO DIRETO, SEM METASIMPLES.
# Configure ONLY in Railway environment variables, never commit actual secrets.
# Required: durable PostgreSQL with tested backup/restore.
GTECH_CHECKOUT_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
# Production payment links become visible only when all three values, durable
# PostgreSQL and the flag above are configured. No recurring subscriptions yet.
